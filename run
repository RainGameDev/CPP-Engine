#!/usr/bin/env bash
set -euo pipefail

BUILD_DIR="${BUILD_DIR:-build}"
BUILD_TYPE="${BUILD_TYPE:-Debug}"

cmake -S . -B "$BUILD_DIR" -DCMAKE_BUILD_TYPE="$BUILD_TYPE" -DCMAKE_CXX_COMPILER="${CXX:-clang++}" -G "${GENERATOR:-Ninja}"
cmake --build "$BUILD_DIR" --target engine
exec "$BUILD_DIR/src/game/engine" "$@"
